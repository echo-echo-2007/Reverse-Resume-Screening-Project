@host = http://localhost:3000

# 本地测试用密码，请自行在下面一行填写，不要把真实密码提交进仓库
@password = 填写你的测试密码

### 健康检查
GET {{host}}/api/health

### 注册 HR（会先建企业，再建用户）
POST {{host}}/api/register
Content-Type: application/json

{
  "role": "hr",
  "phone": "13800000001",
  "password": "{{password}}",
  "name": "张招聘",
  "company_name": "星辰科技有限公司"
}

### 注册求职者
POST {{host}}/api/register
Content-Type: application/json

{
  "role": "seeker",
  "phone": "13900000001",
  "password": "{{password}}",
  "name": "李求职"
}

### 登录
POST {{host}}/api/login
Content-Type: application/json

{
  "phone": "13800000001",
  "password": "{{password}}"
}

### 登录失败（密码错误）
POST {{host}}/api/login
Content-Type: application/json

{
  "phone": "13800000001",
  "password": "wrongpass"
}
