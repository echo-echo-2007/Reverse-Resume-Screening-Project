# 使用方式：复制本文件为 .env，再填入真实值
#   Windows PowerShell: Copy-Item .env.example .env
#   Git Bash:           cp .env.example .env

# 本地 MySQL 连接串（确认数据库已建好，表结构见 ../../sql/01_schema_mysql.sql）
DATABASE_URL="mysql://用户名:密码@127.0.0.1:3306/resume_screening"

# 后端监听端口
PORT=3000

# JWT 签名密钥，必须自己生成，不要使用示例值
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""

# Token 有效期
JWT_EXPIRES_IN="7d"
